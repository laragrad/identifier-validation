{
	"name" : "laragrad/identifier-validation",
	"description" : "Extensions for Laravel validation rules to validate national person and company identifiers",
	"keywords" : [
		"laravel",
		"eloquent",
		"identifier-validation",
		"validation",
		"iban",
		"isin"
	],
	"type" : "package",
	"license" : "MIT",
	"authors" : [{
			"name" : "Ilya Khondozhko",
			"email" : "dev@laragrad.com"
		}
	],
	"require" : {
		"php" : "^8.5"
	},
	"autoload" : {
		"psr-4" : {
			"Laragrad\\IdentifierValidation\\" : "src"
		}
	},
	"extra" : {
		"laravel" : {
			"providers" : [
				"Laragrad\\IdentifierValidation\\IdentifierValidationServiceProvider"
			]
		}
	},
	"minimum-stability" : "dev"
}
